# Copy to .env and fill in. Never commit .env.
ENV=dev                       # set to "prod" in production (enforces strong SECRET_KEY, disables dev login)
SECRET_KEY=                   # 32+ random chars:  openssl rand -hex 32
POSTGRES_PASSWORD=

# Gemini (free tier): https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-2.5-flash
GEMINI_EMBED_MODEL=gemini-embedding-001
EMBED_DIM=768

# Google OAuth (Cloud Console -> APIs & Services -> Credentials -> OAuth client, type "Web application")
# Authorized redirect URI: http://localhost:3000/api/auth/callback
# Enable the "Google Drive API". Add yourself as a test user while the consent screen is in Testing mode.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
PUBLIC_URL=http://localhost:3000
ADMIN_EMAILS=you@example.com  # comma separated; these users become admins on first login

# Optional: raises GitHub API rate limits / reads private repos you have access to
GITHUB_TOKEN=

# Local development only, lets you log in as any email without Google. Must be false in prod.
AUTH_DEV_MODE=false

# Set true if calls to Google hang (network advertises IPv6 but does not route it)
FORCE_IPV4=false

# Non-Docker dev: a folder path keeps the index on disk; ":memory:" is lost on restart.
# docker-compose sets this to the qdrant service automatically.
# QDRANT_URL=./data/qdrant
EMBED_PER_MINUTE=90
RERANKER_MODEL=Xenova/ms-marco-MiniLM-L-6-v2
